# Copy to .env and adjust. Never commit .env.

# --- Infrastructure (docker compose) ---
# Postgres is behind the `database` profile and is not started by default:
#   docker compose --profile database up -d
POSTGRES_USER=servicedesk
POSTGRES_PASSWORD=servicedesk
POSTGRES_DB=servicedesk
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# --- API ---
NODE_ENV=development
API_PORT=3000

# --- Storage ---
# `json` keeps all data in a single document; the working copy is created from
# SEED_FILE on first boot. DATABASE_URL is read only by the future database
# driver and is ignored while STORAGE_DRIVER=json.
STORAGE_DRIVER=json
DATA_FILE=data/servicedesk.json
SEED_FILE=data/seed.json
DATABASE_URL=postgresql://servicedesk:servicedesk@localhost:5432/servicedesk?schema=public
REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access-secret-change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret-change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

PORTAL_URL=http://localhost:5173
WORKSPACE_URL=http://localhost:5174
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# External customer self-registration (see plan §12 item 2)
ALLOW_EXTERNAL_SELF_REGISTRATION=true

# --- Object storage (MinIO / S3 compatible) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=servicedesk-attachments
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# --- Mail (phase 5; MailHog locally, SendGrid on-prem) ---
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Service Desk <support@example.com>"
SENDGRID_API_KEY=
SENDGRID_INBOUND_SIGNING_KEY=

# --- Frontends (Vite) ---
VITE_API_URL=http://localhost:3000
